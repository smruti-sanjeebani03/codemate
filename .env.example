# ===================================================================
# CodeMate - Production & Development Environment Variables
# ===================================================================

# -------------------------------------------------------------------
# 1. Render Frontend Static Site (Client-Side)
# -------------------------------------------------------------------
# Render Backend Web Service URL (e.g. https://codemate-api.onrender.com)
# In local development, leave empty to use Vite local proxy, or set to http://localhost:8080
VITE_API_BASE_URL=
VITE_APP_ENV=production

# -------------------------------------------------------------------
# 2. Render Backend Web Service (Spring Boot)
# -------------------------------------------------------------------
# Port is automatically provided by Render via PORT env var.
# Local development defaults to 8080.
SERVER_PORT=8080

# Supabase PostgreSQL Connection (JDBC with SSL)
# Obtain from Supabase Project Settings -> Database -> Connection string -> JDBC / URI
# Example: jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# CORS & Frontend Origins
# Render Static Site URL (e.g. https://codemate.onrender.com)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Stateless Authentication (Minimum 256-bit secure secret key)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Google OAuth 2.0 (Spring Security / OpenID Connect)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI on Render: https://<your-render-backend-name>.onrender.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 (Spring Security OAuth App)
# Obtain from GitHub -> Settings -> Developer settings -> OAuth Apps
# Authorization callback URL: https://<your-render-backend-name>.onrender.com/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# CodeCat AI Companion (Backend-Only external AI Provider)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com
